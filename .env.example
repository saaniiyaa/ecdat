# ---- runtime ---------------------------------------------------------------
ECDAT_APP_NAME=ECDAT Backend
ECDAT_ENV=dev
ECDAT_VERSION=1.0.0
ECDAT_ENGINE_VERSION=1.0.0
ECDAT_POLICY_PACK=pp-2026.09

# ---- persistence -----------------------------------------------------------
# Laptop / demo (default): zero setup, file backed
DATABASE_URL=sqlite:///./ecdat.db
# Cloud / production (PostgreSQL, any free tier works):
# DATABASE_URL=postgresql+psycopg://ecdat:PASSWORD@HOST/dbname?sslmode=require

# ---- security --------------------------------------------------------------
# Comma separated. The frontend and the CLI can hold different keys.
ECDAT_API_KEYS=dev-ecdat-key
ECDAT_RATE_LIMIT_RPM=240
ECDAT_CORS_ORIGINS=*

# ---- scanning limits -------------------------------------------------------
ECDAT_MAX_UPLOAD_BYTES=536870912
ECDAT_MAX_FILES=50000
ECDAT_MAX_FILE_BYTES=8388608
ECDAT_MAX_CONTAINER_MEMBERS=20000
ECDAT_SCAN_WORKERS=4
# Synchronous exports are bounded: measured ~3 ms per finding to build a CBOM.
# Above this many findings the API returns 413 EXPORT_TOO_LARGE with a remedy.
ECDAT_EXPORT_MAX_FINDINGS=5000

# ---- optional live TLS probe (OFF by default: static-first, air-gap safe) ----
ECDAT_ALLOW_LIVE_PROBE=false
ECDAT_LIVE_PROBE_HOSTS=127.0.0.1,localhost,::1
ECDAT_LIVE_PROBE_TIMEOUT_S=3.0

# ---- attestation -----------------------------------------------------------
# base64 of 32 raw Ed25519 seed bytes. Unset => ephemeral demo key (recorded as
# key_origin=ephemeral_demo in every dossier, never as an operator signature).
# generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# ECDAT_SIGNING_KEY_B64=

ECDAT_LOG_LEVEL=INFO
